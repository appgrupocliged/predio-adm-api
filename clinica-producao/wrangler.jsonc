{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cliged-qr-clinica",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "vars": {
    "CLIGED_AMBIENTE": "clinica-producao",
    "HML_CLINIC_LIVE_ENABLED": "SIM_APROVADO",
    "HML_CLINIC_REAL_COMPLETION_ENABLED": "SIM_APROVADO",
    "HML_CLINIC_LIVE_ALLOWED_LOCAL": "TODOS_9",
    "HML_PILOT_CUSTOMER_ID": "appgrupocliged@gmail.com",
    "HML_PILOT_DEPARTMENT_ID": "2d507dafee35b29d9e5852d9b0c4ce2c",
    "HML_PILOT_OPERATOR_ID": "f2993967f0eaaa58f72ad1d95c7333fd",
    "CLINIC_RETENTION_ENABLED": "NAO",
    "CLINIC_RETENTION_DAYS": "90",
    "CLINIC_RETENTION_BATCH_SIZE": "10"
  },
  "triggers": { "crons": ["0 5 * * 1"] },
  "d1_databases": [{
    "binding": "HML_DB",
    "database_name": "cliged-qr-clinica-db",
    "database_id": "7042e5cf-eca7-48cb-9f5f-9beda76a683b"
  }]
}
