{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cliged-qr-hml-isolado",
  "main": "./worker-hml.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "vars": {
    "CLIGED_AMBIENTE": "homologacao"
  },
  "d1_databases": [
    {
      "binding": "HML_DB",
      "database_name": "cliged-qr-hml-db",
      "database_id": "82da58c7-9846-4d71-86f9-c68dfc1b889a",
      "migrations_dir": "migrations"
    }
  ]
}
